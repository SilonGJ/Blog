---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileConfig, siteConfig } from '../config';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const iconMap: Record<string, string> = {
  github: 'simple-icons:github',
  twitter: 'simple-icons:twitter',
  email: 'lucide:mail',
  qq: 'simple-icons:qq',
  bilibili: 'simple-icons:bilibili',
};

const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.hideHome))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <div id="hero-section" class="min-h-screen flex items-center justify-center px-6 py-16 max-md:px-4 max-md:py-8">
    <div class="w-full max-w-5xl onload-animation">
      <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-0 border border-[var(--border)] overflow-hidden bg-[var(--surface)]">
        <aside class="flex flex-col">
          <div class="w-full aspect-square overflow-hidden border-b border-[var(--border)]">
            <img src={profileConfig.avatar} alt={profileConfig.name} class="w-full h-full object-cover" />
          </div>

          <div class="p-5 flex-1 flex flex-col max-md:p-4">
            <h1 class="text-lg font-bold mb-1 text-[var(--foreground)] max-md:text-base">
              {profileConfig.name}
            </h1>

            <div class="mb-4 max-md:mb-3">
              <p id="hitokoto" class="text-xs text-[var(--muted)] leading-relaxed min-h-[2.5rem] italic">
                {profileConfig.bio}
              </p>
            </div>

            <div class="flex gap-2 mb-4 max-md:mb-3">
              {profileConfig.links.map((link) => (
                <a
                  key={link.name}
                  href={link.url}
                  target={link.url.startsWith('http') ? '_blank' : '_self'}
                  rel="noopener noreferrer"
                  class="button button--ghost button--icon-only h-8 w-8"
                  aria-label={link.name}
                >
                  <Icon name={iconMap[link.icon] || link.icon} class="w-4 h-4" />
                </a>
              ))}
            </div>

            <a
              href="/blog/"
              id="browse-blog-btn"
              data-no-swup
              class="button button--ghost h-9 px-4 text-sm w-full inline-flex items-center justify-center mt-auto"
            >
              进入博客
            </a>
          </div>
        </aside>

        <main class="p-6 border-l border-[var(--border)] flex flex-col gap-6 max-md:p-4 max-md:border-l-0 max-md:border-t max-md:gap-4">
          <section>
            <h2 class="text-sm font-bold mb-3 text-muted uppercase tracking-wider">近期文章</h2>
            <div class="space-y-0">
              {posts.map((post) => (
                <a
                  href={`/posts/${post.id}/`}
                  data-no-swup
                  class="flex items-center justify-between py-3 border-b border-[var(--border)] last:border-b-0 max-md:py-2.5 max-md:gap-2 transition-colors hover:bg-[var(--surface-secondary)] hover:text-[var(--primary)] rounded px-2 -mx-2"
                >
                  <span class="text-sm truncate flex-1">
                    {post.data.title}
                  </span>
                  <span class="text-xs text-[var(--muted)] flex-shrink-0 ml-4 max-md:ml-0">
                    {post.data.pubDate.toLocaleDateString('zh-CN')}
                  </span>
                </a>
              ))}
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>

  <script>
    async function loadHitokoto() {
      const el = document.getElementById('hitokoto');
      if (!el) return;
      try {
        const res = await fetch('https://v1.hitokoto.cn/?c=a&c=b&c=c&c=d&c=i&c=k');
        const data = await res.json();
        if (data.hitokoto) {
          el.textContent = data.hitokoto;
        }
      } catch (e) {}
    }
    loadHitokoto();
  </script>
</BaseLayout>