---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config';

const posts = (await getCollection('posts', ({ data }) => !data.draft && !data.hideHome))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MainLayout title="博客" description="这里是孤久きりのなか(SilonGJ)的博客文章列表，可在这里查看博客全部文章">
  <h1 class="sr-only">博客</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 fade-in-animation">
    {posts.length === 0 ? (
      <div class="card-base p-12 text-center md:col-span-2">
        <p class="text-[var(--muted)]">暂无文章</p>
      </div>
    ) : (
      posts.map((post, i) => <PostCard entry={post} index={i} />)
    )}
  </div>
</MainLayout>
