---
import MainLayout from '../../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';
import { linksConfig } from '../../config';

function normalizeUrl(url: string): string {
  if (!url) return '#';
  if (/^https?:\/\//i.test(url)) return url;
  return `https://${url}`;
}

function getInitial(name: string): string {
  return name ? name.charAt(0).toUpperCase() : '?';
}

const allLinks = linksConfig.groups.flatMap((g) => g.links);
const applyUrl = linksConfig.applyLink ? normalizeUrl(linksConfig.applyLink) : null;
---

<MainLayout title={linksConfig.title}>
  <div class="card-base onload-animation">
    <div class="pl-10 md:pl-12 pr-6 pt-6 md:pt-7 pb-6 relative w-full max-md:pl-6 max-md:pr-4 max-md:pt-5 max-md:pb-5">
      <div class="flex items-start justify-between gap-4 mb-8 max-md:mb-6">
        <h1 class="text-2xl md:text-3xl font-bold relative before:w-1 before:h-6 before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4 md:before:-left-6 before:hidden md:before:block max-md:text-xl">
          {linksConfig.title}
        </h1>
        {applyUrl && (
          <a
            href={applyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="button button--ghost h-10 px-4 font-medium text-sm flex-shrink-0 inline-flex items-center gap-2"
          >
            <Icon name="lucide:external-link" class="w-4 h-4" />
            <span>申请友链</span>
          </a>
        )}
      </div>

      {allLinks.length === 0 ? (
        <div class="card-base p-12 text-center">
          <Icon name="lucide:link" class="w-10 h-10 mx-auto mb-3 text-[var(--muted)]" />
          <p class="text-[var(--muted)]">暂无友链</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {allLinks.map((link, linkIdx) => {
            const safeUrl = normalizeUrl(link.url);
            const hasIcon = !!link.icon && link.icon.trim().length > 0;
            return (
              <a
                key={link.name + safeUrl}
                href={safeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="card-base p-4 flex items-start gap-4 transition-all duration-200 hover:bg-[var(--surface-secondary)] group onload-animation block"
                style={`animation-delay: ${linkIdx * 40}ms;`}
              >
                {hasIcon ? (
                  <img
                    src={link.icon}
                    alt={link.name}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="w-12 h-12 flex-shrink-0 object-cover border border-[var(--border)] bg-[var(--surface-secondary)]"
                    onerror="this.style.display='none'; const fallback = this.nextElementSibling; if (fallback) fallback.style.display = 'flex';"
                  />
                ) : null}
                <div
                  class={hasIcon ? 'w-12 h-12 flex-shrink-0 border border-[var(--border)] bg-[var(--surface-secondary)] items-center justify-center text-xl font-bold text-[var(--muted)] hidden' : 'w-12 h-12 flex-shrink-0 border border-[var(--border)] bg-[var(--surface-secondary)] flex items-center justify-center text-xl font-bold text-[var(--muted)]'}
                >
                  {getInitial(link.name)}
                </div>
                <div class="flex-1 min-w-0 overflow-hidden">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-bold text-[var(--foreground)] truncate group-hover:text-[var(--primary)] transition-colors">
                      {link.name}
                    </span>
                    <Icon
                      name="lucide:external-link"
                      class="w-3.5 h-3.5 flex-shrink-0 text-[var(--muted)] opacity-0 group-hover:opacity-100 transition-opacity"
                    />
                  </div>
                  {link.description ? (
                            <p class="text-xs text-[var(--muted)] line-clamp-2 leading-relaxed">
                              {link.description}
                            </p>
                          ) : (
                            <p class="text-xs text-[var(--muted)] italic">
                              暂无描述
                            </p>
                          )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>
</MainLayout>
