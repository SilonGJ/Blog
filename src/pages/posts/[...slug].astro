---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const stats = readingTime(post.body);

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

<MainLayout title={post.data.title} description={post.data.description} headings={headings}>
  <article class="card-base onload-animation max-w-4xl mx-auto" style="animation-delay: 200ms">
    <div class="px-6 md:px-8 pt-6 md:pt-7 pb-6 relative w-full">
      <header class="mb-8 pb-6 border-b border-[var(--divider)]">
        <h1 class="text-3xl md:text-4xl font-bold mb-4 text-[var(--foreground)] relative before:w-1 before:h-7 before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4 md:before:-left-6">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--muted)]">
          {post.data.pubDate && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" x2="16" y1="2" y2="6"/>
                <line x1="8" x2="8" y1="2" y2="6"/>
                <line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </span>
          )}
          {post.data.updatedDate && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
                <path d="M21 3v5h-5"/>
              </svg>
              更新于 {post.data.updatedDate.toLocaleDateString('zh-CN')}
            </span>
          )}
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {stats.text}
          </span>
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            {Math.round(stats.words)} 字
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2 mt-4">
          {post.data.category && (
            <a href={`/categories/${post.data.category}/`} class="btn-regular px-3 py-1 text-sm font-medium">
              {post.data.category}
            </a>
          )}
          {post.data.tags.length > 0 && post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="btn-plain px-2.5 py-1 text-sm border border-[var(--border)]">
              #{tag}
            </a>
          ))}
        </div>
      </header>

      <div id="post-content" class="prose prose-invert max-w-none prose-headings:scroll-mt-24">
        <Content />
      </div>
    </div>
  </article>

  <nav class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 onload-animation max-w-4xl mx-auto" style="animation-delay: 350ms">
    {prevPost ? (
      <a href={`/posts/${prevPost.id}/`} class="card-base p-4 transition hover:bg-[var(--btn-card-bg-hover)] group">
        <div class="text-sm text-[var(--muted)] mb-1 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          上一篇
        </div>
        <div class="font-medium group-hover:text-[var(--primary)] transition-colors line-clamp-1">
          {prevPost.data.title}
        </div>
      </a>
    ) : <div></div>}
    {nextPost ? (
      <a href={`/posts/${nextPost.id}/`} class="card-base p-4 transition hover:bg-[var(--btn-card-bg-hover)] group text-right">
        <div class="text-sm text-[var(--muted)] mb-1 flex items-center gap-1 justify-end">
          下一篇
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </div>
        <div class="font-medium group-hover:text-[var(--primary)] transition-colors line-clamp-1">
          {nextPost.data.title}
        </div>
      </a>
    ) : <div></div>}
  </nav>
</MainLayout>

<style is:global>
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    scroll-margin-top: 5rem;
  }

  .prose {
    color: var(--foreground);
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--foreground);
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
    line-height: 1.4;
  }

  .prose h1 {
    font-size: 2rem;
    margin-top: 0;
  }

  .prose h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--divider);
  }

  .prose h3 {
    font-size: 1.25rem;
    margin-top: 1.75rem;
  }

  .prose h4 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
    color: var(--foreground);
  }

  .prose h5 {
    font-size: 1rem;
    margin-top: 1.25rem;
    color: oklch(0.88 0.006 260);
  }

  .prose h6 {
    font-size: 0.875rem;
    margin-top: 1rem;
    color: var(--muted);
  }

  .prose p {
    margin: 1rem 0;
    color: var(--foreground);
  }

  .prose a {
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--link-underline);
    padding-bottom: 1px;
    transition: all 0.2s ease;
    font-weight: 500;
  }

  .prose a:hover {
    color: var(--link-hover);
    border-bottom-color: transparent;
    background-color: var(--btn-plain-bg-hover);
    border-radius: 2px;
    padding: 1px 2px;
    margin: -1px -2px;
  }

  .prose code {
    background-color: var(--surface-secondary);
    color: var(--foreground);
    padding: 0.125rem 0.4rem;
    font-size: 0.875em;
    border-radius: 4px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    border: 1px solid var(--border);
  }

  .prose pre {
    background-color: var(--codeblock-bg) !important;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .prose pre code {
    background: none;
    padding: 0;
    border: none;
    font-size: 0.875rem;
    line-height: 1.7;
    border-radius: 0;
    color: var(--foreground);
  }

  .prose .code-block-wrapper {
    position: relative;
    margin: 1.5rem 0;
  }

  .prose .code-block-wrapper pre {
    margin: 0;
    padding-top: 2.25rem;
  }

  .prose .code-lang-label {
    position: absolute;
    top: 0.625rem;
    left: 1rem;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--muted);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    text-transform: lowercase;
    pointer-events: none;
    z-index: 1;
  }

  .prose .code-block-wrapper::before {
    content: '';
    position: absolute;
    top: 2rem;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--border);
    z-index: 1;
  }

  .prose .code-copy-btn {
    position: absolute;
    top: 0.125rem;
    right: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: var(--muted);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .prose .code-copy-btn:hover {
    color: var(--foreground);
    background-color: var(--surface-tertiary);
    border-color: var(--border);
  }

  .prose .code-copy-btn:active {
    transform: scale(0.9);
  }

  .prose .code-copy-btn .success-icon {
    display: none;
  }

  .prose .code-copy-btn.copied {
    color: var(--success);
  }

  .prose .code-copy-btn.copied .copy-icon {
    display: none;
  }

  .prose .code-copy-btn.copied .success-icon {
    display: block;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    color: var(--muted);
    font-style: normal;
    background-color: var(--surface);
    border-left: none;
    position: relative;
    border-radius: 0 6px 6px 0;
  }

  .prose blockquote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 4px;
    background-color: var(--primary);
    border-radius: 0 2px 2px 0;
  }

  .prose blockquote p {
    margin: 0.5rem 0;
  }

  .prose blockquote p:first-child {
    margin-top: 0;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.75rem;
    margin: 1rem 0;
  }

  .prose li {
    margin: 0.5rem 0;
    line-height: 1.7;
  }

  .prose ul li::marker {
    color: var(--primary);
  }

  .prose ol li::marker {
    color: var(--primary);
    font-weight: 600;
  }

  .prose ul ul,
  .prose ul ol,
  .prose ol ul,
  .prose ol ol {
    margin: 0.5rem 0;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: 1.75rem auto;
    display: block;
    cursor: zoom-in;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    text-align: left;
  }

  .prose th {
    background-color: var(--surface-secondary);
    font-weight: 600;
    color: var(--foreground);
  }

  .prose tbody tr:nth-child(even) {
    background-color: var(--surface);
  }

  .prose tbody tr:hover {
    background-color: var(--surface-secondary);
  }

  .prose hr {
    border: none;
    border-top: 1px dashed var(--divider);
    margin: 2rem 0;
    opacity: 0.7;
  }

  .prose strong {
    color: var(--foreground);
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
    color: oklch(0.90 0.006 260);
  }

  .prose del {
    color: var(--muted);
    text-decoration: line-through;
  }

  .prose kbd {
    background-color: var(--surface-secondary);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    font-family: inherit;
  }

  .prose mark {
    background-color: color-mix(in oklab, var(--primary) 25%, transparent);
    color: var(--foreground);
    padding: 0 0.125rem;
  }
</style>
