---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import { siteConfig } from '../../config';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const stats = readingTime(post.body);

const allPosts = (await getCollection('posts', ({ data }) => !data.draft && !data.hideNav))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
];
if (post.data.category) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: post.data.category,
    item: new URL(`/categories/${post.data.category}/`, Astro.site).href,
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: breadcrumbItems.length + 1,
  name: post.data.title,
  item: canonicalURL,
});

const postJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
      author: { '@type': 'Person', name: siteConfig.author },
      publisher: {
        '@type': 'Organization',
        name: siteConfig.title,
        logo: { '@type': 'ImageObject', url: new URL('/images/favicon.png', Astro.site).href },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      ...(post.data.cover && { image: new URL(post.data.cover, Astro.site).href }),
    },
    { '@type': 'BreadcrumbList', '@id': `${canonicalURL}#breadcrumb`, itemListElement: breadcrumbItems },
  ],
};
---

<MainLayout title={post.data.title} description={post.data.description} headings={headings} cover={post.data.cover} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate}>
  <script type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
  <article class="card-base onload-animation max-w-4xl mx-auto" data-slug={post.id}>
    {post.data.cover && (
      <figure class="post-cover w-full">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt || post.data.title}
          class="img-fade w-full aspect-video object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}
    <div class="px-6 md:px-8 pt-6 md:pt-7 pb-6 relative w-full max-md:px-4 max-md:pt-5 max-md:pb-5">
      <header class="mb-8 pb-6 border-b border-[var(--divider)] max-md:mb-6 max-md:pb-5">
        <h1 class="text-3xl md:text-4xl font-bold mb-4 text-[var(--foreground)] max-md:text-2xl max-md:leading-tight">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[var(--muted)] max-md:gap-x-3 max-md:text-xs">
          {post.data.pubDate && (
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:calendar" class="w-4 h-4 max-md:w-[14px] max-md:h-[14px]" />
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </span>
          )}
          {post.data.updatedDate && (
            <span class="flex items-center gap-1.5">
              <Icon name="lucide:rotate-cw" class="w-4 h-4 max-md:w-[14px] max-md:h-[14px]" />
              更新于 {post.data.updatedDate.toLocaleDateString('zh-CN')}
            </span>
          )}
          <span class="flex items-center gap-1.5">
            <Icon name="lucide:clock" class="w-4 h-4 max-md:w-[14px] max-md:h-[14px]" />
            {Math.max(1, Math.round(stats.minutes))} 分钟
          </span>
          <span class="flex items-center gap-1.5 max-sm:hidden">
            <Icon name="lucide:file-text" class="w-4 h-4 max-md:w-[14px] max-md:h-[14px]" />
            {Math.round(stats.words)} 字
          </span>
          <span class="flex items-center gap-1.5 max-sm:hidden">
            <Icon name="lucide:eye" class="w-4 h-4 max-md:w-[14px] max-md:h-[14px]" />
            <span id="view-count">--</span>
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2 mt-4">
          {post.data.category && (
            <a href={`/categories/${post.data.category}/`} class="chip chip--default max-md:text-xs">
              {post.data.category}
            </a>
          )}
          {post.data.tags.length > 0 && post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="chip chip--default chip--soft text-xs">
              #{tag}
            </a>
          ))}
        </div>
      </header>

      <div id="post-content" class="prose prose-invert max-w-none prose-headings:scroll-mt-24">
        <Content />
      </div>
    </div>
  </article>

  {post.data.comment !== false && (
    <div id="giscus-container" class="card-base onload-animation max-w-4xl mx-auto mt-6 max-md:mt-4">
      <div class="px-6 md:px-8 py-5 md:py-6 max-md:px-4 max-md:py-4">
        <div id="giscus-slot"></div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var container = document.getElementById('giscus-slot');
        if (!container) return;

        var themeUrl = window.location.origin + '/giscus/theme.css';

        var script = document.createElement('script');
        script.src = 'https://giscus.app/client.js';
        script.setAttribute('data-repo', 'SilonGJ/Blog');
        script.setAttribute('data-repo-id', 'R_kgDOTlEalA');
        script.setAttribute('data-category', '评论');
        script.setAttribute('data-category-id', 'DIC_kwDOTlEalM4DC72O');
        script.setAttribute('data-mapping', 'pathname');
        script.setAttribute('data-strict', '1');
        script.setAttribute('data-reactions-enabled', '1');
        script.setAttribute('data-emit-metadata', '0');
        script.setAttribute('data-input-position', 'top');
        script.setAttribute('data-theme', themeUrl);
        script.setAttribute('data-lang', 'zh-CN');
        script.setAttribute('data-loading', 'lazy');
        script.setAttribute('data-reactions-enabled', '0');
        script.crossOrigin = 'anonymous';
        script.async = true;

        container.appendChild(script);
      })();
    </script>
  )}

  {!post.data.hideNav && (
    <nav class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 onload-animation max-w-4xl mx-auto max-md:gap-3">
      {prevPost ? (
        <a href={`/posts/${prevPost.id}/`} class="card-base p-4 transition hover:bg-[var(--btn-card-bg-hover)] group max-md:p-3 max-md:order-2 md:order-1">
          <div class="text-sm text-[var(--muted)] mb-1 flex items-center gap-1">
            <Icon name="lucide:chevron-left" class="w-3.5 h-3.5" />
            上一篇
          </div>
          <div class="font-medium group-hover:text-[var(--primary)] transition-colors line-clamp-1 max-md:text-sm">
            {prevPost.data.title}
          </div>
        </a>
      ) : <div class="hidden md:block order-1"></div>}
      {nextPost ? (
        <a href={`/posts/${nextPost.id}/`} class="card-base p-4 transition hover:bg-[var(--btn-card-bg-hover)] group text-right max-md:p-3 max-md:order-1 md:order-2">
          <div class="text-sm text-[var(--muted)] mb-1 flex items-center gap-1 justify-end">
            下一篇
            <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" />
          </div>
          <div class="font-medium group-hover:text-[var(--primary)] transition-colors line-clamp-1 max-md:text-sm">
            {nextPost.data.title}
          </div>
        </a>
      ) : <div class="hidden md:block order-2"></div>}
    </nav>
  )}
</MainLayout>

<style is:global>
  .post-cover img {
    cursor: zoom-in;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    scroll-margin-top: 5rem;
  }

  .prose {
    color: var(--foreground);
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: var(--foreground);
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
    line-height: 1.4;
  }

  .prose h1 {
    font-size: 2rem;
    margin-top: 0;
  }

  .prose h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    margin-top: 1.75rem;
  }

  .prose h4 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
    color: var(--foreground);
  }

  .prose h5 {
    font-size: 1rem;
    margin-top: 1.25rem;
    color: oklch(0.88 0.006 260);
  }

  .prose h6 {
    font-size: 0.875rem;
    margin-top: 1rem;
    color: var(--muted);
  }

  .prose p {
    margin: 1rem 0;
    color: var(--foreground);
  }

  .prose a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: left bottom;
    transition: background-size 0.3s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .prose a:hover {
    color: var(--link-hover);
    background-color: var(--btn-plain-bg-hover);
    background-size: 100% 2px;
  }

  .prose code {
    background-color: var(--surface-secondary);
    color: var(--foreground);
    padding: 0.125rem 0.4rem;
    font-size: 0.875em;
    border-radius: 4px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    border: 1px solid var(--border);
  }

  .prose pre {
    background-color: var(--codeblock-bg) !important;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .prose pre code {
    background: none;
    padding: 0;
    border: none;
    font-size: 0.875rem;
    line-height: 1.7;
    border-radius: 0;
    color: var(--foreground);
  }

  .prose .code-block-wrapper {
    position: relative;
    margin: 1.5rem 0;
  }

  .prose .code-block-wrapper pre {
    margin: 0;
    padding-top: 3rem;
  }

  .prose .code-lang-label {
    position: absolute;
    top: 0.625rem;
    left: 1rem;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--muted);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    text-transform: lowercase;
    pointer-events: none;
    z-index: 1;
  }

  .prose .code-block-wrapper::before {
    content: '';
    position: absolute;
    top: 2rem;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--border);
    z-index: 1;
  }

  .prose .code-copy-btn {
    position: absolute;
    top: 0.125rem;
    right: 0.5rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: var(--muted);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 2;
  }

  .prose .code-copy-btn:hover {
    color: var(--foreground);
    background-color: var(--surface-tertiary);
    border-color: var(--border);
  }

  .prose .code-copy-btn:active {
    transform: scale(0.9);
  }

  .prose .code-copy-btn .success-icon {
    display: none;
  }

  .prose .code-copy-btn.copied {
    color: var(--success);
  }

  .prose .code-copy-btn.copied .copy-icon {
    display: none;
  }

  .prose .code-copy-btn.copied .success-icon {
    display: block;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.125rem 0 0.125rem 1rem;
    color: var(--muted);
    font-style: normal;
    border-left: none;
    position: relative;
  }

  .prose blockquote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 4px;
    background-color: var(--primary);
    border-radius: 0 2px 2px 0;
  }

  .prose blockquote p {
    margin: 0.5rem 0;
  }

  .prose blockquote p:first-child {
    margin-top: 0;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1rem;
    margin: 1rem 0;
  }

  .prose ol {
    list-style-type: decimal;
    padding-left: 1rem;
    margin: 1rem 0;
  }

  .prose li {
    margin: 0.5rem 0;
    line-height: 1.7;
  }

  .prose ul li::marker {
    color: var(--primary);
  }

  .prose ol li::marker {
    color: var(--primary);
    font-weight: 600;
  }

  .prose ul ul,
  .prose ul ol,
  .prose ol ul,
  .prose ol ol {
    margin: 0.5rem 0;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: 1.75rem 0;
    display: block;
    cursor: zoom-in;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    text-align: left;
  }

  .prose th {
    background-color: var(--surface-secondary);
    font-weight: 600;
    color: var(--foreground);
  }

  .prose tbody tr:nth-child(even) {
    background-color: var(--surface);
  }

  .prose tbody tr:hover {
    background-color: var(--surface-secondary);
  }

  .prose hr {
    border: none;
    border-top: 1px dashed var(--divider);
    margin: 2rem 0;
    opacity: 0.7;
  }

  .prose strong {
    color: var(--foreground);
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
    color: oklch(0.90 0.006 260);
  }

  .prose del {
    color: var(--muted);
    text-decoration: line-through;
  }

  .prose kbd {
    background-color: var(--surface-secondary);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    font-family: inherit;
  }

  .prose mark {
    background-color: color-mix(in oklab, var(--primary) 25%, transparent);
    color: var(--foreground);
    padding: 0 0.125rem;
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 0.9375rem;
      line-height: 1.75;
    }

    .prose h1 {
      font-size: 1.75rem;
      margin-top: 0;
    }

    .prose h2 {
      font-size: 1.375rem;
      margin-top: 2rem;
    }

    .prose h3 {
      font-size: 1.125rem;
      margin-top: 1.5rem;
    }

    .prose h4 {
      font-size: 1rem;
      margin-top: 1.25rem;
    }

    .prose p {
      margin: 0.875rem 0;
    }

    .prose pre {
      padding: 1rem;
      margin: 1.25rem 0;
    }

    .prose pre code {
      font-size: 0.8125rem;
    }

    .prose .code-block-wrapper pre {
      padding-top: 2.5rem;
    }

    .prose ul,
    .prose ol {
      padding-left: 1.5rem;
      margin: 0.875rem 0;
    }

    .prose li {
      margin: 0.375rem 0;
    }

    .prose blockquote {
      padding: 0.125rem 0 0.125rem 0.75rem;
      margin: 1.25rem 0;
    }

    .prose img {
      margin: 1.25rem auto;
    }

    .prose table {
      font-size: 0.875rem;
      margin: 1.25rem 0;
    }

    .prose th,
    .prose td {
      padding: 0.5rem 0.75rem;
    }

    .prose code {
      font-size: 0.8125em;
      padding: 0.1rem 0.3rem;
    }
  }
</style>
