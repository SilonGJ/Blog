---
import MainLayout from '../layouts/MainLayout.astro';
import { profileConfig } from '../config';
---

<MainLayout title="关于" description="关于我和这个博客">
  <div class="card-base onload-animation">
    <div class="pl-10 md:pl-12 pr-6 pt-6 md:pt-7 pb-6 relative w-full max-md:pl-6 max-md:pr-4 max-md:pt-5 max-md:pb-5">
      <h1 class="text-2xl md:text-3xl font-bold mb-8 relative before:w-1 before:h-6 before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4 md:before:-left-6 before:hidden md:before:block onload-animation max-md:text-xl max-md:mb-6">
        关于
      </h1>

      <div class="prose prose-invert max-w-none onload-animation">
        <div class="flex flex-col md:flex-row gap-8 mb-8 max-md:gap-6 max-md:mb-6">
          <div class="w-32 h-32 overflow-hidden border-2 border-[var(--border)] flex-shrink-0 max-md:w-24 max-md:h-24">
            <img src={profileConfig.avatar} alt={profileConfig.name} class="w-full h-full object-cover" />
          </div>
          <div>
            <h2 class="text-2xl font-bold mb-2 max-md:text-xl">{profileConfig.name}</h2>
            <p class="text-[var(--muted)] mb-4">{profileConfig.bio}</p>
            <div class="flex flex-wrap gap-3">
              {profileConfig.links.map((link) => (
                <a
                  href={link.url}
                  target={link.url.startsWith('http') ? '_blank' : '_self'}
                  rel="noopener noreferrer"
                  class="btn-regular px-3 py-1.5 text-sm active:scale-95 transition-transform"
                >
                  {link.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <h2>关于这个博客</h2>
        <p>
          这是一个使用 <strong>Astro</strong> 框架和 <strong>HeroUI</strong> 组件库构建的个人博客。
          采用纯静态生成，加载速度快，SEO 友好。
        </p>

        <h2>技术栈</h2>
        <ul>
          <li><strong>Astro</strong> - 静态站点生成器</li>
          <li><strong>HeroUI</strong> - React UI 组件库</li>
          <li><strong>Tailwind CSS</strong> - CSS 框架</li>
          <li><strong>TypeScript</strong> - 类型安全</li>
          <li><strong>Pagefind</strong> - 静态搜索</li>
        </ul>

        <h2>联系方式</h2>
        <p>
          如果你有任何问题或合作意向，欢迎通过以下方式联系我：
        </p>
        <ul>
          <li>Email: <a href={`mailto:${profileConfig.email}`}>{profileConfig.email}</a></li>
        </ul>
      </div>
    </div>
  </div>
</MainLayout>
