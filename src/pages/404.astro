---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
---

<BaseLayout title="404 - 页面未找到" description="页面未找到">
  <div class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <h1 class="text-7xl md:text-9xl font-bold text-[var(--primary)] mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold mb-4">页面未找到</h2>
      <p class="text-[var(--muted)] mb-8">
        抱歉，您访问的页面不存在或已被移除。
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
            href="/blog/"
            data-no-swup
            class="px-6 py-3 bg-[var(--primary)] text-[var(--accent-foreground)] font-bold active:scale-95 transition-all"
          >
            返回博客
          </a>
          <a
            href="/"
            data-no-swup
            class="px-6 py-3 btn-regular font-bold active:scale-95 transition-all border border-[var(--border)]"
          >
            返回首页
          </a>
      </div>
    </div>
  </div>
</BaseLayout>
