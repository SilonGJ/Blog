---
import '../styles/global.css';
import '../styles/photoswipe.css';
import 'photoswipe/style.css';
import { siteConfig } from '../config';
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  description?: string;
  showNavbar?: boolean;
  showFooter?: boolean;
}

const { title, description, showNavbar = true, showFooter = true } = Astro.props;

const pageTitle = title ? `${title} - ${siteConfig.title}` : `${siteConfig.title} - ${siteConfig.subtitle}`;
const pageDescription = description || siteConfig.description;
---

<!DOCTYPE html>
<html lang={siteConfig.lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={siteConfig.author} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta name="shenma-site-verification" content="abec1aa4205bb47c7222c762c3768892_1786432966" />
    <meta name="msvalidate.01" content="3A08DBB14D79705C0BE044E5CE984594" />
    <meta name="baidu-site-verification" content="codeva-sgsOarr5x7" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <slot />

    <div id="external-dialog" aria-hidden="true">
      <div id="external-dialog-backdrop" class="external-dialog-backdrop"></div>
      <div id="external-dialog-panel" class="float-panel external-dialog-panel external-dialog-closed w-[min(90vw,22rem)] p-5" role="dialog" aria-modal="true" aria-labelledby="external-dialog-title">
        <h3 id="external-dialog-title" class="text-base font-bold flex items-center gap-2">
          <Icon name="lucide:external-link" class="w-4 h-4" />
          即将离开本站
        </h3>
        <p class="text-sm text-muted mt-2">该链接指向外部网站，请注意隐私政策以及风险</p>
        <div id="external-dialog-url" class="mt-3 px-3 py-2 text-xs break-all bg-[var(--surface-secondary)] border border-[var(--border)]"></div>
        <div class="mt-4 flex justify-end gap-2">
          <button id="external-dialog-cancel" class="button button--ghost h-9 px-4 text-sm">取消</button>
          <button id="external-dialog-confirm" class="button button--primary h-9 px-4 text-sm">继续前往</button>
        </div>
      </div>
    </div>
  <script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import { getViewsBatchCached, incrementView, getViews, isVisited } from "../utils/views";

    let lightbox;
    let pswp = import("photoswipe");

    function createPhotoSwipe() {
      if (lightbox) {
        lightbox.destroy();
        lightbox = null;
      }

      document.querySelectorAll(".pswp").forEach((el) => el.remove());

      lightbox = new PhotoSwipeLightbox({
        gallery: ".prose img",
        pswpModule: () => pswp,
        closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
        padding: { top: 20, bottom: 20, left: 20, right: 20 },
        wheelToZoom: true,
        imageClickAction: "close",
        tapAction: "close",
        doubleTapAction: "zoom",
      });

      lightbox.addFilter("domItemData", (itemData, element) => {
        if (element instanceof HTMLImageElement) {
          itemData.src = element.src;
          itemData.w = Number(element.naturalWidth || window.innerWidth);
          itemData.h = Number(element.naturalHeight || window.innerHeight);
          itemData.msrc = element.src;
        }
        return itemData;
      });

      lightbox.init();
    }

    function destroyPhotoSwipe() {
      if (lightbox) {
        lightbox.destroy();
        lightbox = null;
      }
      document.querySelectorAll(".pswp").forEach((el) => el.remove());
    }

    function setupCodeBlocks() {
      const pres = document.querySelectorAll(".prose pre");
      pres.forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-block-wrapper")) return;

        const code = pre.querySelector("code");
        let lang = "";
        if (pre.dataset.language) {
          lang = pre.dataset.language;
        } else if (code) {
          const match = code.className.match(/language-(\w+)/);
          if (match) lang = match[1];
        }

        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper";
        wrapper.style.position = "relative";

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        if (lang) {
          const langLabel = document.createElement("div");
          langLabel.className = "code-lang-label";
          langLabel.textContent = lang;
          wrapper.appendChild(langLabel);
        }

        const copyBtn = document.createElement("button");
        copyBtn.className = "code-copy-btn";
        copyBtn.innerHTML = `
          <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <svg class="success-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        `;
        copyBtn.addEventListener("click", async () => {
          const text = code?.textContent || "";
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add("copied");
            setTimeout(() => copyBtn.classList.remove("copied"), 2000);
          } catch (e) {
            console.error("复制失败:", e);
          }
        });
        wrapper.appendChild(copyBtn);
      });
    }

    const CACHE_TTL = 30 * 60 * 1000;

    function renderDetailViews(count) {
      const el = document.getElementById("view-count");
      if (el) el.textContent = String(count);
    }

    function setupViews() {
      const slugs = [...new Set([...document.querySelectorAll("[data-slug]")]
        .map((el) => el.getAttribute("data-slug")))];
      if (slugs.length === 0) return;

      const isDetailPage = !!document.querySelector("article[data-slug]");

      if (isDetailPage) {
        const slug = document.querySelector("article[data-slug]").getAttribute("data-slug");
        if (!isVisited(slug)) {
          incrementView(slug).then((count) => renderDetailViews(count));
        } else {
          const ts = localStorage.getItem("vw_ts_" + slug);
          if (ts && Date.now() - Number(ts) < CACHE_TTL) {
            renderDetailViews(Number(localStorage.getItem("vw_" + slug) ?? "0"));
          } else {
            getViews(slug).then((count) => renderDetailViews(count));
          }
        }
      } else {
        getViewsBatchCached(slugs).then((data) => {
          document.querySelectorAll(".view-count").forEach((el) => {
            const slug = el.getAttribute("data-slug");
            if (slug && data[slug] !== undefined) {
              el.textContent = String(data[slug]);
            }
          });
        });
      }
    }

    /* ===== 搜索结果高度动画：有内容时打开 Grid 行 ===== */
    function setupSearchHeightAnimation() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const searchResults = document.getElementById('search-results');
      const wrapper = document.getElementById('search-results-wrapper');
      if (!searchInput || !searchResults || !wrapper) return;

      const updateOpen = () => {
        const hasHeight = searchResults.children.length > 0 && searchResults.scrollHeight > 0;
        const hasText = searchInput.value.trim().length > 0;
        if (hasHeight && hasText) {
          wrapper.classList.add('search-results-open');
        } else {
          wrapper.classList.remove('search-results-open');
        }
      };

      searchInput.addEventListener('input', () => {
        setTimeout(updateOpen, 30);
        setTimeout(updateOpen, 150);
      });

      const observer = new MutationObserver(() => {
        updateOpen();
      });
      observer.observe(searchResults, { childList: true });

      // 打开/关闭搜索面板时重置
      const panel = document.getElementById('search-panel');
      if (panel) {
        const mo = new MutationObserver(() => {
          if (panel.classList.contains('float-panel-closed')) {
            wrapper.classList.remove('search-results-open');
          }
        });
        mo.observe(panel, { attributes: true, attributeFilter: ['class'] });
      }
    }

    const setup = () => {
      createPhotoSwipe();
      setupCodeBlocks();
      setupViews();
      setupSearchHeightAnimation();

      if (window.swup) {
        // 1) 注册"先滚顶再切"的阻塞前置钩子
        registerSwupScrollToTop(window.swup);
        // 2) swup 切页过渡（旧向下滑出 / 新反向淡入）完全由 global.css 的 @keyframes
        //    针对 transition-swup-is-animating / transition-swup-is-rendering 官方 class 驱动，
        //    这里不再手动注入 class，避免和 astro.config 的 animationClass 时序冲突。
        window.swup.hooks.on(
          "content:replace",
          () => {
            destroyPhotoSwipe();
          },
          { before: true }
        );
        window.swup.hooks.on("page:view", () => {
          createPhotoSwipe();
          setupCodeBlocks();
          setupViews();
          closeExternalDialog();
          setTimeout(setupSearchHeightAnimation, 50);
        });
      }
    };

    /* ===== 切页前：先平滑滚顶部 → 再发起导航
     *  用 swup v4 官方阻塞式 hook（visit:start 返回 Promise 时 swup 等待 resolve 后才继续离场动画 + DOM 替换）
     *  不再自己拦截 <a> click，100% 与 swup 流程同步，永不漏触发
     *  同时 astro.config 已关 swup.scrollToTop，避免 swup 切完后再重复滚一次
     */
    function scrollToTopBlocking(): Promise<void> {
      return new Promise((resolve) => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // 已经在顶部 → 立刻放行
        if (window.scrollY === 0) { resolve(); return; }
        const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';
        window.scrollTo({ top: 0, left: 0, behavior });

        let resolved = false;
        const done = () => { if (!resolved) { resolved = true; resolve(); } };

        // 通路 A：监听 scroll，真正到达顶部（scrollY <= 2）就放行
        const onScroll = () => { if (window.scrollY <= 2) { cleanup(); done(); } };
        const cleanup = () => window.removeEventListener('scroll', onScroll);
        window.addEventListener('scroll', onScroll, { passive: true });

        // 通路 B：兜底超时，到点未到顶也先硬滚 0 再放行（prefers-reduced 立即）
        const timeout = reduced ? 0 : 500;
        window.setTimeout(() => {
          if (!resolved) {
            if (window.scrollY > 2) window.scrollTo(0, 0);
            cleanup();
            done();
          }
        }, timeout);
      });
    }
    // 注册 scrollToTopBlocking 为 swup 的 visit:start 前置阻塞钩子（全局唯一一次）
    // 注意：swup v4 的 hooks 支持传入 before 选项返回 Promise 来阻塞整个 visit 流程
    function registerSwupScrollToTop(swup: any) {
      if ((swup as any).__scrollHookRegistered) return;
      (swup as any).__scrollHookRegistered = true;
      try {
        swup.hooks.on('visit:start', async () => {
          await scrollToTopBlocking();
        });
      } catch {
        // 老版本 swup 不支持 async hook，降级为非阻塞但仍然立即滚顶
        swup.hooks.on('visit:start', () => {
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, left: 0, behavior: reduced ? 'auto' : 'smooth' });
        });
      }
    }

    if (window.swup) {
      setup();
    } else {
      document.addEventListener("swup:enable", setup);
      // 开发模式下 swup 未启用时兜底
      window.addEventListener('load', () => {
        setTimeout(setupSearchHeightAnimation, 100);
      });
    }

    /* ===== 外链跳转确认弹窗（document 级委托，swup 换页后依然有效） ===== */
    let pendingExternalLink = null;

    function isExternalHttp(href) {
      try {
        const url = new URL(href, window.location.href);
        return /^https?:$/.test(url.protocol) && url.origin !== window.location.origin;
      } catch {
        return false;
      }
    }

    function closeExternalDialog() {
      const panel = document.getElementById('external-dialog-panel');
      const backdrop = document.getElementById('external-dialog-backdrop');
      const dialog = document.getElementById('external-dialog');
      if (panel) panel.classList.add('external-dialog-closed');
      if (backdrop) backdrop.classList.remove('external-dialog-open');
      if (dialog) dialog.setAttribute('aria-hidden', 'true');
      pendingExternalLink = null;
    }

    function openExternalDialog(anchor) {
      const panel = document.getElementById('external-dialog-panel');
      const backdrop = document.getElementById('external-dialog-backdrop');
      const urlEl = document.getElementById('external-dialog-url');
      const dialog = document.getElementById('external-dialog');
      if (!panel || !backdrop) return;
      pendingExternalLink = anchor;
      if (urlEl) urlEl.textContent = anchor.href;
      panel.classList.remove('external-dialog-closed');
      backdrop.classList.add('external-dialog-open');
      if (dialog) dialog.setAttribute('aria-hidden', 'false');
      document.getElementById('external-dialog-confirm')?.focus();
    }

    function confirmExternalLink() {
      if (!pendingExternalLink) { closeExternalDialog(); return; }
      const href = pendingExternalLink.href;
      if (pendingExternalLink.target === '_blank') {
        window.open(href, '_blank', 'noopener,noreferrer');
      } else {
        window.location.href = href;
      }
      closeExternalDialog();
    }

    function setupExternalLinkDialog() {
      if (window.__externalDialogReady) return;
      window.__externalDialogReady = true;

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const anchor = target.closest('a[href]');
        if (!anchor) return;
        if (e.defaultPrevented) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (anchor.hasAttribute('data-no-external-dialog')) return;
        if (!isExternalHttp(anchor.href)) return;
        e.preventDefault();
        openExternalDialog(anchor);
      }, true);

      document.getElementById('external-dialog-confirm')?.addEventListener('click', confirmExternalLink);
      document.getElementById('external-dialog-cancel')?.addEventListener('click', closeExternalDialog);
      document.getElementById('external-dialog-backdrop')?.addEventListener('click', closeExternalDialog);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeExternalDialog();
      });
    }

    setupExternalLinkDialog();
  </script>
  </body>
</html>
