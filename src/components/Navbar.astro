---
import { navBarConfig, siteConfig } from '../config';
import { Icon } from 'astro-icon/components';

// 当前页面是否为博客首页（/blog 或 /blog/）
const pathname = Astro.url.pathname;
const isBlogHome = pathname === '/blog' || pathname === '/blog/';
// 博客首页：跳转主站 /；其他页：跳转博客首页 /blog/
const homeHref = isBlogHome ? '/' : '/blog/';
const needNoSwup = isBlogHome; // 跨子站跳转不用 swup
---

<div id="navbar" class="fixed top-0 left-0 right-0 z-40" style="opacity: 0;">
  <nav class="w-full flex items-center px-4 h-14 bg-surface/80 backdrop-blur-xl border-b border-border transition-all duration-300">
    <a
      id="navbar-home-btn"
      href={homeHref}
      data-is-blog-home={String(isBlogHome)}
      class="button button--ghost h-10 px-4 font-bold navbar-home-btn-base navbar-home-btn"
      {...(needNoSwup ? { 'data-no-swup': true } : {})}
    >
      <span class="navbar-home-icon-slot">
        <span class="navbar-home-icon navbar-home-icon-house">
          <Icon name="lucide:house" class="navbar-home-icon-svg" />
        </span>
        <span class="navbar-home-icon navbar-home-icon-arrow">
          <Icon name="lucide:arrow-left" class="navbar-home-icon-svg" />
        </span>
      </span>
      <Icon name="lucide:folder" class="hidden" />
      <span id="navbar-home-text-slot" class="navbar-home-text-slot">
        <span
          id="navbar-home-text-title"
          class:list={['navbar-home-text', 'navbar-home-text-title', !isBlogHome && 'navbar-home-text-overlay']}
        >{siteConfig.title}</span>
        <span
          id="navbar-home-text-back"
          class:list={['navbar-home-text', 'navbar-home-text-back', isBlogHome && 'navbar-home-text-overlay']}
        >返回博客</span>
      </span>
      {/* 离屏测宽器：用完全相同的文字（visibility:hidden）放到文档流里，随时读取真实宽度 */}
      <span aria-hidden="true" class="navbar-home-text-measurer">
        <span class="navbar-home-text-measurer-title">{siteConfig.title}</span>
        <span class="navbar-home-text-measurer-back">返回博客</span>
      </span>
    </a>

    <div class="flex items-center gap-2 ml-auto">
      <div id="nav-links-container" class="hidden md:flex items-center gap-2 relative">
        {navBarConfig.links.map((link) => (
          <a
            href={link.url}
            data-nav-link
            data-nav-url={link.url}
            class="button button--ghost h-10 px-4 font-medium text-sm nav-underline-btn"
          >
            {link.name}
          </a>
        ))}
        <div id="nav-underline-indicator" class="absolute bottom-0 h-[2px] bg-[var(--accent)] rounded-full pointer-events-none transition-all duration-300 ease-out opacity-0"></div>
      </div>

      <button
        id="search-toggle"
        class="button button--ghost button--icon-only w-10 h-10"
        aria-label="搜索"
      >
        <Icon name="lucide:search" class="w-[18px] h-[18px]" />
      </button>

      <button
        id="nav-menu-toggle"
        class="button button--ghost button--icon-only w-10 h-10 md:hidden"
        aria-label="菜单"
      >
        <Icon name="lucide:menu" class="w-[18px] h-[18px]" />
      </button>
    </div>
  </nav>

  <div id="page-progress" class="h-px w-full bg-transparent relative overflow-hidden">
    <div id="page-progress-bar" class="absolute top-0 left-0 h-full w-0 bg-[var(--accent)] transition-all duration-150 ease-out"></div>
  </div>

  <div id="search-panel" class="float-panel float-panel-closed fixed left-1/2 -translate-x-1/2 top-20 w-[90%] max-w-xl z-50 p-4">
    <div class="input-wrapper">
      <input
        id="search-input"
        type="text"
        class="input w-full h-11 px-4"
        placeholder="搜索文章..."
      />
    </div>
    <div id="search-results-wrapper" class="mt-3 search-results-grid">
      <div id="search-results" class="overflow-y-auto hide-scrollbar max-h-96"></div>
    </div>
  </div>

  <div id="nav-menu-panel" class="float-panel float-panel-closed fixed right-4 top-20 w-48 z-50 md:hidden">
    <div class="flex flex-col">
      {navBarConfig.links.map((link, i) => (
        <a
          href={link.url}
          class="button button--ghost h-12 px-5 font-medium text-left justify-start w-full"
          style={`border-top: ${i === 0 ? 'none' : '1px solid var(--separator)'}`}
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  function togglePanel(panelId: string) {
    const panel = document.getElementById(panelId);
    if (panel) {
      panel.classList.toggle('float-panel-closed');
      const isOpen = !panel.classList.contains('float-panel-closed');
      if (panelId === 'search-panel') {
        toggleSearchBackdrop(isOpen);
      }
    }
  }

  function closePanel(panelId: string) {
    const panel = document.getElementById(panelId);
    if (panel) {
      panel.classList.add('float-panel-closed');
      if (panelId === 'search-panel') {
        toggleSearchBackdrop(false);
      }
    }
  }

  function toggleSearchBackdrop(show: boolean) {
    const backdrop = document.getElementById('search-backdrop');
    if (backdrop) {
      if (show) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
      } else {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  }

  const searchToggle = document.getElementById('search-toggle');
  const navMenuToggle = document.getElementById('nav-menu-toggle');

  searchToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePanel('search-panel');
    closePanel('nav-menu-panel');
    setTimeout(() => {
      document.getElementById('search-input')?.focus();
    }, 50);
  });

  navMenuToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePanel('nav-menu-panel');
    closePanel('search-panel');
  });

  const searchBackdrop = document.getElementById('search-backdrop');
  searchBackdrop?.addEventListener('click', () => {
    closePanel('search-panel');
  });

  document.addEventListener('click', (e) => {
    const searchPanel = document.getElementById('search-panel');
    const navMenuPanel = document.getElementById('nav-menu-panel');
    const target = e.target as HTMLElement;

    if (searchPanel && !searchPanel.contains(target) && !searchToggle?.contains(target)) {
      closePanel('search-panel');
    }
    if (navMenuPanel && !navMenuPanel.contains(target) && !navMenuToggle?.contains(target)) {
      closePanel('nav-menu-panel');
    }
  });

  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  let pagefind: any = null;
  let pagefindLoading = false;

  async function loadPagefind() {
    if (pagefind || pagefindLoading) return;
    pagefindLoading = true;
    try {
      const pagefindModule = await eval('import("/pagefind/pagefind.js")');
      pagefind = pagefindModule;
      if (pagefind) {
        await pagefind.options({ excerptLength: 20 });
      }
    } catch (e) {
      console.warn('Pagefind not available (expected in dev mode)');
    }
  }

  searchInput?.addEventListener('focus', () => {
    loadPagefind();
  });

  searchInput?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value;
    if (!query.trim()) {
      if (searchResults) searchResults.innerHTML = '';
      return;
    }
    await loadPagefind();
    if (!pagefind) {
      if (searchResults) {
        searchResults.innerHTML = '<div class="text-muted text-center py-4">搜索功能在开发模式下不可用</div>';
      }
      return;
    }

    const search = await pagefind.search(query);
    const results = await Promise.all(search.results.map((r: any) => r.data()));

    if (searchResults) {
      if (results.length === 0) {
        searchResults.innerHTML = '<div class="text-muted text-center py-4">未找到相关结果</div>';
      } else {
        searchResults.innerHTML = results.map((result: any) => `
          <a href="${result.url}" class="block p-3 hover:bg-surface-secondary transition-colors border-b border-b border-separator last:border-b-0">
            <div class="font-bold text-foreground mb-1">${result.meta.title}</div>
            <div class="text-sm text-muted line-clamp-2">${result.excerpt}</div>
          </a>
        `).join('');
      }
    }
  });

  let progressTimer = null;
  let progressValue = 0;
  let initialLoadComplete = false;
  let isReadingProgress = false;

  function isPostPage() {
    return window.location.pathname.startsWith('/posts/');
  }

  function updateReadingProgress() {
    const bar = document.getElementById('page-progress-bar');
    if (!bar) return;

    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;

    bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
  }

  function enableReadingProgress() {
    const bar = document.getElementById('page-progress-bar');
    if (!bar) return;

    bar.style.opacity = '0';

    setTimeout(() => {
      const originalTransition = bar.style.transition;
      bar.style.transition = 'none';
      updateReadingProgress();
      void bar.offsetWidth;
      bar.style.transition = originalTransition;

      setTimeout(() => {
        bar.style.opacity = '1';
        isReadingProgress = true;
        window.addEventListener('scroll', updateReadingProgress, { passive: true });
      }, 50);
    }, 250);
  }

  function disableReadingProgress() {
    isReadingProgress = false;
    window.removeEventListener('scroll', updateReadingProgress);
  }

  function startProgress() {
    const bar = document.getElementById('page-progress-bar');
    if (!bar) return;

    disableReadingProgress();

    progressValue = 0;
    bar.style.width = '0%';
    bar.style.opacity = '1';

    if (progressTimer) clearInterval(progressTimer);

    progressTimer = setInterval(() => {
      if (progressValue < 90) {
        progressValue += Math.random() * 8;
        if (progressValue > 90) progressValue = 90;
        bar.style.width = `${progressValue}%`;
      }
    }, 150);
  }

  function finishProgress() {
    const bar = document.getElementById('page-progress-bar');
    if (!bar) return;

    if (progressTimer) {
      clearInterval(progressTimer);
      progressTimer = null;
    }

    if (isPostPage()) {
      bar.style.width = '100%';
      setTimeout(() => {
        enableReadingProgress();
      }, 300);
    } else {
      bar.style.width = '100%';
      setTimeout(() => {
        bar.style.opacity = '0';
        setTimeout(() => {
          bar.style.width = '0%';
        }, 200);
      }, 100);
    }
  }

  startProgress();

  window.addEventListener('load', () => {
    if (!initialLoadComplete) {
      initialLoadComplete = true;
      finishProgress();
    }
  });

  const setupProgressBar = () => {
    if (window.swup) {
      window.swup.hooks.on('visit:start', () => {
        startProgress();
      });
      window.swup.hooks.on('page:view', () => {
        finishProgress();
      });
    }
  };

  if (window.swup) {
    setupProgressBar();
  } else {
    document.addEventListener('swup:enable', setupProgressBar);
  }

  function isBlogHomePage() {
    return window.location.pathname === '/blog/' || window.location.pathname === '/blog';
  }

  function playSlideInAnimation() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    navbar.style.opacity = '0';
    navbar.style.transform = 'translateY(-100%)';
    navbar.style.transition = 'none';
    void navbar.offsetWidth;
    navbar.style.transition = 'transform 0.5s ease-out, opacity 0.5s ease-out';
    requestAnimationFrame(() => {
      navbar.style.transform = 'translateY(0)';
      navbar.style.opacity = '1';
    });
    // 关键：Navbar 动画结束后（500ms 后）再把指示器硬落位一次
    // 因为首屏 opacity=0 期间 getBoundingClientRect 可能取到异常值
    setTimeout(() => updateNavUnderline({ animate: false }), 520);
  }

  function ensureNavbarVisible() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    navbar.style.opacity = '1';
    navbar.style.transform = 'translateY(0)';
  }

  function initNavbarAnimation() {
    playSlideInAnimation();
  }

  initNavbarAnimation();

  /* ===== Navbar 下划线指示器（极简稳定版） =====
   *  - 单一"定位函数"：总是基于当前 DOM rect 实时算，不存任何旧值
   *  - hover 期间 updateUnderline 完全被锁，不再反复覆盖位置造成跳
   *  - mouseleave 时再实时计算 active rect 返回，不用"存的 style"
   */
  type Rect = { left: number; width: number };
  function getLinkRect(container: HTMLElement, link: HTMLElement | null): Rect | null {
    if (!link) return null;
    const cr = container.getBoundingClientRect();
    const lr = link.getBoundingClientRect();
    return { left: lr.left - cr.left, width: lr.width };
  }

  function normalizePath(p: string): string {
    // Astro base 可能是 /blog，所以 pathname 可能是 /blog/archive/。
    // 兼容：去掉 /blog 前缀 + 末尾补 /（除了根），统一比较格式
    let s = p.replace(/\/+$/, '') || '/';
    if (s.startsWith('/blog')) s = s.slice('/blog'.length);
    if (!s.startsWith('/')) s = '/' + s;
    // 只有 "/" 和末尾为 "/" 的路径需要前缀匹配，其他（如 /posts/about）也补 "/" 前缀匹配
    return s === '/' ? s : s + '/';
  }

  function findActiveLink(links: NodeListOf<HTMLAnchorElement>): HTMLAnchorElement | null {
    const raw = window.location.pathname;
    const currentPath = normalizePath(raw);
    let best: HTMLAnchorElement | null = null;
    let bestLen = 0;
    links.forEach((link) => {
      const url = link.dataset.navUrl || '';
      if (!url) return;
      const normUrl = normalizePath(url);
      const exact = currentPath === normUrl;
      const prefix = currentPath.startsWith(normUrl);
      if (exact && normUrl.length > bestLen) {
        bestLen = normUrl.length;
        best = link;
      } else if (!best && prefix && normUrl.length > bestLen) {
        bestLen = normUrl.length;
        best = link;
      }
    });
    return best;
  }

  let isHovering = false; // hover 期间外部更新全部被锁，不碰指示器位置

  function updateNavUnderline({ animate = false }: { animate?: boolean } = {}) {
    const container = document.getElementById('nav-links-container');
    const indicator = document.getElementById('nav-underline-indicator');
    if (!container || !indicator) return;
    const links = container.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    if (links.length === 0) return;

    const active = findActiveLink(links);
    links.forEach((l) => l.classList.toggle('nav-link-active', l === active));

    // hover 期间只更新文字 active 状态，不更新指示器位置（让 hover 接管）
    if (isHovering) return;

    const rect = getLinkRect(container, active);

    // 初始化/路由切换/resize 时关闭过渡瞬间落位，之后再开
    if (!animate) {
      indicator.style.transition = 'none';
    } else {
      indicator.style.transition = 'left 300ms ease-out, width 300ms ease-out, opacity 200ms ease-out';
    }
    if (rect) {
      indicator.style.left = `${rect.left}px`;
      indicator.style.width = `${rect.width}px`;
      indicator.style.opacity = '1';
    } else {
      indicator.style.opacity = '0';
    }
    if (!animate) {
      // 强制 reflow 后再恢复过渡（让过渡用于后续变化）
      void indicator.offsetWidth;
      indicator.style.transition = 'left 300ms ease-out, width 300ms ease-out, opacity 200ms ease-out';
    }
  }

  // 防止多次快速点击叠加以至 overlay 状态错乱
  let homeButtonSwitchTimer: number | null = null;

  /* ===== 左侧主页按钮：路由变化后动态切换 图标/文字/href/宽度 =====
   *  宽度平滑变化的步骤：
   *    1. 用离屏 .navbar-home-text-measurer 取到"目标文字"的真实宽度
   *    2. 下一帧把 slot.style.width 固定为这个值（CSS transition 会平滑过渡）
   *    3. 同一帧：切换 overlay class（新文字变 overlay 即 absolute 重叠，不参与宽度；
   *              旧文字暂时保留 static 作为过渡起点宽度）
   *       同时：切换 data-is-blog-home 属性触发图标/文字的 opacity 交叉淡入淡出
   *    4. 240ms 过渡结束：交换 overlay 归属（新文字变 static 接管宽度，旧变 overlay）
   *              并清 width: auto，恢复自适应。此后 hover 用的是新文字真实宽度。
   *  图标淡入淡出 + 宽度变化 + 文字淡入淡出三者 transition 参数完全相同（240ms ease-out），
   *  因此三者在同一个 rAF 写入后"真正同时"开始和结束。
   */
  function updateHomeButton() {
    const btn = document.getElementById('navbar-home-btn') as HTMLAnchorElement | null;
    const slot = document.getElementById('navbar-home-text-slot') as HTMLElement | null;
    const titleText = document.getElementById('navbar-home-text-title') as HTMLElement | null;
    const backText = document.getElementById('navbar-home-text-back') as HTMLElement | null;
    if (!btn || !slot || !titleText || !backText) return;

    // 测宽器里文字完全复刻真实字体/字号，随时可用
    const measurerTitle = btn.querySelector<HTMLElement>('.navbar-home-text-measurer-title');
    const measurerBack = btn.querySelector<HTMLElement>('.navbar-home-text-measurer-back');
    if (!measurerTitle || !measurerBack) return;

    const p = window.location.pathname;
    const isBlogHomeNow = p === '/blog' || p === '/blog/';
    const wasBlogHome = btn.getAttribute('data-is-blog-home') === 'true';
    // 状态没变就不做动画，只保证 href/属性最新
    if (isBlogHomeNow === wasBlogHome && homeButtonSwitchTimer === null) {
      btn.href = isBlogHomeNow ? '/' : '/blog/';
      return;
    }

    const targetWidthPx = (isBlogHomeNow ? measurerTitle : measurerBack).getBoundingClientRect().width;
    const currentWidthPx = slot.getBoundingClientRect().width;

    // 先关闭旧的 width transition，固定在当前宽度，避免下一行写 width 时从 auto 直接跳到目标值（丢失过渡）
    slot.style.transition = 'none';
    slot.style.width = `${currentWidthPx}px`;
    // 强制 reflow，让新 width 生效后再开 transition
    void slot.offsetWidth;
    slot.style.transition = ''; // 恢复 CSS 中声明的 width transition

    if (homeButtonSwitchTimer !== null) {
      clearTimeout(homeButtonSwitchTimer);
      homeButtonSwitchTimer = null;
    }

    // 下一帧：1) 宽度写到目标值 2) 切换 data 属性触发 opacity 3) 两边 class 保持不变（宽度固定后是靠 width transition）
    requestAnimationFrame(() => {
      slot.style.width = `${targetWidthPx}px`;
      if (isBlogHomeNow) {
        btn.href = '/';
        btn.setAttribute('data-is-blog-home', 'true');
        btn.setAttribute('data-no-swup', 'true');
      } else {
        btn.href = '/blog/';
        btn.setAttribute('data-is-blog-home', 'false');
        btn.removeAttribute('data-no-swup');
      }

      homeButtonSwitchTimer = window.setTimeout(() => {
        // 过渡结束：切换 overlay 的归属（新文字变 static 撑开宽度），并把宽度恢复为 auto（下一步 hover/布局自适应）
        if (isBlogHomeNow) {
          titleText.classList.remove('navbar-home-text-overlay');
          backText.classList.add('navbar-home-text-overlay');
        } else {
          titleText.classList.add('navbar-home-text-overlay');
          backText.classList.remove('navbar-home-text-overlay');
        }
        slot.style.transition = 'none';
        slot.style.width = 'auto';
        void slot.offsetWidth;
        slot.style.transition = '';
        homeButtonSwitchTimer = null;
      }, 250); // 略大于 240ms，保证动画 100% 结束
    });
  }

  function setupNavLinkHoverIndicator() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    // 需求：hover 不动横条，只做文字加粗和背景 hover
    // 文字加粗/变色由 CSS 的 .nav-underline-btn:hover 负责
    // 背景 hover 由 .button--ghost 自身样式负责
    // 这里只需要在 hover 期间锁住外部 updateUnderline，以免在动画中间被 resize 之类事件意外覆盖
    links.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        isHovering = true;
      });
      link.addEventListener('mouseleave', () => {
        isHovering = false;
      });
    });
  }

  // 初始化
  const initNavUnderline = () => {
    // 首屏瞬间落位（无动画，避免从 0,0 滑过来的跳）
    updateHomeButton();
    updateNavUnderline({ animate: false });
    setupNavLinkHoverIndicator();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavUnderline);
  } else {
    initNavUnderline();
  }
  // resize 用无动画瞬时落位（窗口缩放应该是硬对齐不该有滑动动画，更稳不乱跳）
  window.addEventListener('resize', () => updateNavUnderline({ animate: false }));
  document.addEventListener('astro:page-load', () => {
    updateHomeButton();
    updateNavUnderline({ animate: true });
  });

  if (window.swup) {
    window.swup.hooks.on('page:view', () => {
      const navbar = document.getElementById('navbar');
      if (navbar) {
        playSlideInAnimation();
      }
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          updateHomeButton();
          updateNavUnderline({ animate: true });
        });
      });
    });
  }
</script>

<style>
  #page-progress-bar {
    transition: width 150ms ease-out, opacity 200ms ease-out;
  }

  /* ===== 左侧主页按钮：只布局对齐，样式完全复用 button/button--ghost ===== */
  .navbar-home-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 0.5rem !important;
    line-height: 1 !important;
    white-space: nowrap;
  }

  /* ===== 图标槽：CSS Grid stacking（共享 cell），两图标占据同一格，互相叠放
     容器宽高 = 1.25rem（两个图标都能填进去），Grid 布局保证两者都参与尺寸
     —— 最终槽永远取子元素的最大宽高，不会塌缩，不会错位。*/
  .navbar-home-icon-slot {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    display: inline-grid;
    grid-template: 1fr / 1fr;
    place-items: center;
  }
  .navbar-home-icon {
    grid-area: 1 / 1;          /* 两个图标都放在同一个 cell，完全重叠 */
    display: inline-grid;
    place-items: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    /* 只过渡 opacity，不用任何 transform，彻底消除横向跳动和"先偏移再回正" */
    transition: opacity 240ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  .navbar-home-icon-svg,
