---
import { profileConfig } from '../config';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const posts = await getCollection('posts', ({ data }) => !data.draft);

const categoriesMap = new Map<string, number>();
const tagsMap = new Map<string, number>();

for (const post of posts) {
  if (post.data.category) {
    categoriesMap.set(post.data.category, (categoriesMap.get(post.data.category) || 0) + 1);
  }
  for (const tag of post.data.tags) {
    tagsMap.set(tag, (tagsMap.get(tag) || 0) + 1);
  }
}

const categories = Array.from(categoriesMap.entries()).sort((a, b) => b[1] - a[1]);
const tags = Array.from(tagsMap.entries()).sort((a, b) => b[1] - a[1]);

const iconMap: Record<string, string> = {
  github: 'simple-icons:github',
  twitter: 'simple-icons:twitter',
  email: 'lucide:mail',
  qq: 'simple-icons:qq',
  bilibili: 'simple-icons:bilibili',
};
---

<div id="sidebar" class:list={[className, "w-full h-full"]}>
  <div class="flex flex-col w-full h-full gap-4">
    <div class="card card--default p-6 text-center sidebar-profile">
      <div class="w-24 h-24 mx-auto mb-4 overflow-hidden border border-border">
        <img src={profileConfig.avatar} alt={profileConfig.name} class="w-full h-full object-cover" />
      </div>
      <h3 class="text-xl font-bold mb-2">{profileConfig.name}</h3>
      <p class="text-sm text-muted mb-4">{profileConfig.bio}</p>
      <div class="flex justify-center gap-3">
        {profileConfig.links.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : '_self'}
            rel="noopener noreferrer"
            class="button button--ghost button--icon-only w-10 h-10"
            aria-label={link.name}
          >
            <Icon name={iconMap[link.icon] || link.icon} class="w-5 h-5" />
          </a>
        ))}
      </div>
    </div>

    <div id="sidebar-sticky" class="sticky top-20 flex flex-col gap-4">
      <div id="sidebar-toc" class="card card--default p-5 hidden">
        <h4 class="font-bold text-sm mb-3 text-muted uppercase tracking-wider">目录</h4>
        <nav id="sidebar-toc-nav" class="space-y-1 overflow-y-auto toc-scroll">
        </nav>
      </div>

      {categories.length > 0 && (
        <div id="sidebar-categories" class="card card--default p-5 onload-animation">
          <h4 class="font-bold text-sm mb-3 text-muted uppercase tracking-wider flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
            </svg>
            分类
          </h4>
          <div class="flex flex-wrap gap-2">
            {categories.map(([category, count]) => (
              <a
                href={`/categories/${category}/`}
                class="chip chip--default"
              >
                {category}
                <span class="ml-1.5 text-muted">({count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {tags.length > 0 && (
        <div id="sidebar-tags" class="card card--default p-5 onload-animation">
          <h4 class="font-bold text-sm mb-3 text-muted uppercase tracking-wider flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 5 6.3 6.3a2.4 2.4 0 0 1 0 3.4L17 19"/>
              <path d="M9.586 5.586A2 2 0 0 0 8.172 5H3a1 1 0 0 0-1 1v5.172a2 2 0 0 0 .586 1.414L12 22"/>
              <path d="M15 5a2 2 0 0 1 2 2"/>
              <circle cx="5" cy="9" r="1"/>
            </svg>
            标签
          </h4>
          <div class="flex flex-wrap gap-2">
            {tags.map(([tag, count]) => (
              <a
                href={`/tags/${tag}/`}
                class="chip chip--default chip--soft text-xs"
              >
                #{tag}
                <span class="ml-1 text-muted opacity-70">{count}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  let tocObserver = null;
  let anchorNavTarget = null;

  function updateTocHeight() {
    const tocNav = document.getElementById('sidebar-toc-nav');
    const tocCard = document.getElementById('sidebar-toc');
    const stickyContainer = document.getElementById('sidebar-sticky');

    if (!tocNav || !tocCard || !stickyContainer) return;

    const stickyTop = 80;
    const gap = 16;
    let availableHeight = window.innerHeight - stickyTop;

    const cards = stickyContainer.querySelectorAll(':scope > .card');
    cards.forEach((card) => {
      if (card === tocCard || card.classList.contains('hidden')) return;
      availableHeight -= (card.offsetHeight + gap);
    });

    const tocHeader = tocCard.querySelector('h4');
    const tocHeaderHeight = tocHeader ? tocHeader.offsetHeight + 12 : 40;
    const maxTocNavHeight = availableHeight - tocHeaderHeight - 40;

    tocNav.style.maxHeight = Math.max(120, maxTocNavHeight) + 'px';
  }

  function handleTocClick(event) {
    const anchor = event.composedPath().find((el) => el instanceof HTMLAnchorElement);
    if (!anchor) return;

    const tocNav = document.getElementById('sidebar-toc-nav');
    if (!tocNav || !tocNav.contains(anchor)) return;

    const id = decodeURIComponent(anchor.hash?.substring(1));
    if (!id) return;

    const heading = document.getElementById(id);
    if (!heading) return;

    event.preventDefault();
    anchorNavTarget = heading;

    const navHeight = 64;
    const targetTop = heading.getBoundingClientRect().top + window.scrollY - navHeight;
    window.scrollTo({ top: targetTop, behavior: 'smooth' });
    history.pushState(null, '', `#${id}`);
  }

  function buildSidebarToc() {
    const tocCard = document.getElementById('sidebar-toc');
    const tocNav = document.getElementById('sidebar-toc-nav');
    const content = document.getElementById('post-content');
    const tagsCard = document.getElementById('sidebar-tags');

    anchorNavTarget = null;

    if (tocObserver) {
      tocObserver.disconnect();
      tocObserver = null;
    }

    if (!tocCard || !tocNav) return;

    if (!content) {
      tocCard.classList.add('hidden');
      if (tagsCard) tagsCard.classList.remove('hidden');
      return;
    }

    if (tagsCard) {
      tagsCard.classList.add('hidden');
    }

    const headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      tocCard.classList.add('hidden');
      if (tagsCard) tagsCard.classList.remove('hidden');
      return;
    }

    tocNav.innerHTML = '';

    headings.forEach((heading) => {
      const depth = parseInt(heading.tagName.charAt(1));
      const text = heading.textContent || '';
      const slug = heading.id || '';

      const link = document.createElement('a');
      link.href = `#${slug}`;
      link.dataset.slug = slug;
      link.className = 'toc-link block py-1.5 px-3 text-sm text-muted hover:text-accent hover:bg-surface-secondary transition-all truncate border-l-2 border-transparent hover:border-accent';
      link.style.paddingLeft = `${(depth - 2) * 12 + 12}px`;
      link.textContent = text;

      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        anchorNavTarget = heading;

        const navHeight = 64;
        const rect = heading.getBoundingClientRect();
        const targetTop = rect.top + window.scrollY - navHeight;
        window.scrollTo({ top: targetTop, behavior: 'smooth' });
        history.pushState(null, '', `#${slug}`);
      });

      tocNav.appendChild(link);
    });

    tocCard.classList.remove('hidden');

    setTimeout(() => {
      updateTocHeight();
      setupTocScrollSpy();
    }, 50);
  }

  function setupTocScrollSpy() {
    const content = document.getElementById('post-content');
    const tocNav = document.getElementById('sidebar-toc-nav');
    if (!content || !tocNav) return;

    const headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) return;

    const observerOptions = {
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0,
    };

    tocObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && anchorNavTarget === entry.target) {
          anchorNavTarget = null;
        }
      });

      if (anchorNavTarget) return;

      entries.forEach((entry) => {
        const slug = entry.target.id;
        const link = tocNav.querySelector(`.toc-link[data-slug="${slug}"]`);
        if (!link) return;

        if (entry.isIntersecting) {
          tocNav.querySelectorAll('.toc-link').forEach((l) => {
            l.classList.remove('toc-link--active');
          });
          link.classList.add('toc-link--active');

          const navRect = tocNav.getBoundingClientRect();
          const linkRect = link.getBoundingClientRect();
          if (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom) {
            link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
        }
      });
    }, observerOptions);

    headings.forEach((heading) => {
      if (heading.id) {
        tocObserver.observe(heading);
      }
    });
  }

  let resizeTimeout = null;
  window.addEventListener('resize', () => {
    if (resizeTimeout) clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(updateTocHeight, 100);
  });

  buildSidebarToc();
  document.addEventListener('astro:page-load', buildSidebarToc);

  if (window.swup) {
    window.swup.hooks.on('page:view', buildSidebarToc);
    window.swup.hooks.on('visit:start', () => {
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.style.transition = 'opacity 200ms ease';
        sidebar.style.opacity = '0';
      }
    });
    window.swup.hooks.on('page:view', () => {
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.style.transition = 'opacity 200ms ease';
        sidebar.style.opacity = '1';
      }
    });
  } else {
    document.addEventListener('swup:enable', () => {
      window.swup.hooks.on('page:view', buildSidebarToc);
      window.swup.hooks.on('visit:start', () => {
        const sidebar = document.getElementById('sidebar');
        if (sidebar) {
          sidebar.style.transition = 'opacity 200ms ease';
          sidebar.style.opacity = '0';
        }
      });
      window.swup.hooks.on('page:view', () => {
        const sidebar = document.getElementById('sidebar');
        if (sidebar) {
          sidebar.style.transition = 'opacity 200ms ease';
          sidebar.style.opacity = '1';
        }
      });
    });
  }
</script>

<style is:global>
  html {
    scroll-padding-top: 5rem;
  }

  .toc-scroll {
    min-height: 0;
  }

  .toc-link--active {
    color: var(--accent) !important;
    border-left-color: var(--accent) !important;
    background-color: var(--surface-secondary);
    font-weight: 500;
  }

  #sidebar-tags.hidden {
    display: none !important;
  }
</style>
