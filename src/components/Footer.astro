---
import { siteConfig, profileConfig } from '../config';
---

<footer class="text-center py-8 text-sm text-[var(--muted)]">
  <div class="border-t border-[var(--divider)] pt-6">
    <p>&copy; {new Date().getFullYear()} {profileConfig.name}. All rights reserved.</p>
    <p class="mt-2">
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[var(--primary)] hover:underline">Astro</a> & <a href="https://heroui.com" target="_blank" rel="noopener noreferrer" class="text-[var(--primary)] hover:underline">HeroUI</a>
    </p>
    <p class="mt-2">
      <a href="/rss.xml" class="text-[var(--muted)] hover:text-[var(--primary)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1 mb-0.5">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
        RSS
      </a>
    </p>
  </div>
</footer>
